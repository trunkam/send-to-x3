# Credenziali AMO per la firma dell'estensione (web-ext sign).
# Copiare questo file in `.env` e incollare le proprie chiavi.
# `.env` e' in .gitignore: non finisce mai su GitHub.
#
# Si generano su: https://addons.mozilla.org/developers/addon/api/key/
# Il secret e' mostrato UNA SOLA VOLTA: se lo si perde, va rigenerato.

WEB_EXT_API_KEY=user:00000000:000
WEB_EXT_API_SECRET=
